{
  "name": "@kelsoncm/tiptap-core",
  "version": "0.2.0",
  "description": "Núcleo framework-agnóstico do editor KelsonCM TipTap: extensões, comandos, i18n e UI em DOM.",
  "license": "MIT",
  "author": "Kelson da Costa Medeiros <kelsoncm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelsoncm/tiptap-core.git"
  },
  "homepage": "https://github.com/kelsoncm/tiptap-core#readme",
  "bugs": "https://github.com/kelsoncm/tiptap-core/issues",
  "keywords": [
    "tiptap",
    "prosemirror",
    "wysiwyg",
    "editor",
    "rich-text"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-table-of-contents": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.13.0",
    "@tiptap/pm": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
