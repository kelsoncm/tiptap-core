{
  "name": "@kelsoncm/tiptap-core",
  "version": "0.18.1",
  "description": "Núcleo framework-agnóstico do editor KelsonCM TipTap: extensões, comandos, i18n e UI em DOM.",
  "license": "MIT",
  "author": "Kelson da Costa Medeiros <kelsoncm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiptap-by-kelsoncm/tiptap-core.git"
  },
  "homepage": "https://tiptap-by-kelsoncm.github.io/tiptap-core/",
  "bugs": "https://github.com/tiptap-by-kelsoncm/tiptap-core/issues",
  "keywords": [
    "tiptap",
    "prosemirror",
    "wysiwyg",
    "editor",
    "rich-text"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./office": {
      "types": "./dist/office.d.ts",
      "import": "./dist/office.js"
    },
    "./styles.css": "./dist/styles/kelson-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:umd": "vite build --config vite.umd.config.ts && node -e \"require('fs').copyFileSync('src/styles/kelson-editor.css','dist-umd/kelsoncm-tiptap-core.css')\"",
    "check:umd": "node scripts/check-umd.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run site:dev",
    "site:fetch-wc": "node site/fetch-webcomponent.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-bubble-menu": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-details": "^3.35.0",
    "@tiptap/extension-file-handler": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-mathematics": "^3.35.0",
    "@tiptap/extension-mention": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-table-of-contents": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.11",
    "lowlight": "^3.3.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "@abrasileirado/dsgovbr-bootstrapped": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependenciesMeta": {
    "mammoth": {
      "optional": true
    }
  }
}
